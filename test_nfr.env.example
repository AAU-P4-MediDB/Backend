# Copy this file to test_nfr.env and fill in real values.
# test_nfr.env is for local/test use only — never commit real credentials
# or the JWT signing key. Add it to .gitignore.

# Where the API is running.
BASE_URL=http://192.168.134.230:10140

# Clinic-staff account with position "Doctor" and MFA DISABLED, so login
# returns tokens directly instead of a 202 MFA challenge.
TEST_EMAIL=john@clinic.dk
TEST_PASSWORD=pass

# An existing patient's CPR in the DDMMYY-XXXX format used by
# ptdataFetchingRequest.
TEST_CPR=120578-1234

# Only needed for the NFR-05 forged-expired-token check. Must exactly match
# the server's Jwt:Key / Jwt:Issuer / Jwt:Audience configuration.
JWT_
JWT_ISSUER=medidb-backend
JWT_AUDIENCE=medidb-frontend

# Requirement thresholds (defaults match the NFR table).
EXPECTED_SESSION_MINUTES=60
PERF_BUDGET_SECONDS=2.0
PERF_SAMPLES=5

# Optional: enable the stronger NFR-02 audit-log check by pointing this at
# the Postgres database directly (requires the psql client).
# AUDIT_DB_URL=postgres://user:pass@localhost:5432/medidb
# AUDIT_TABLE=audit_log

RESULTS_FILE=nfr_results.md
